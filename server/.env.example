# Copy to server/.env and fill in. Never commit .env.
PORT=4000
MONGO_URI=mongodb://localhost:27017/chatsphere
REDIS_URL=redis://localhost:6379
# Any long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Browser origin(s) of the React client, comma-separated
CLIENT_ORIGIN=http://localhost:5173
